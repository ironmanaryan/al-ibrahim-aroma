# Required in production — any long random string (e.g. `openssl rand -hex 32`)
AUTH_SECRET=

# Optional but recommended: durable JSON storage on serverless.
# Works with Upstash Redis REST or Vercel KV (KV_REST_API_* is also read).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: override the data directory for the local file store
# DATA_DIR=
